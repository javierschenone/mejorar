{
  // Sólo para `typecheck` (lo corre `build`). Este paquete no compila a `dist`:
  // Vitest ejecuta con su propio transpilador. Cubre `src/**` —el código de
  // aplicación (autorización, auditoría; feature 002, T-04)— y los tests del
  // esquema en `prisma/**`.
  //
  // Hasta el commit que agregó `src/**/*.ts` acá, `include` sólo tenía
  // `prisma/**`: ningún archivo de `src/` se typechequeaba, y un "build limpio"
  // no decía nada sobre ellos. Si se agrega un árbol nuevo de código, va acá.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `ESNext` + `bundler` y no el `commonjs` de la base: los tests usan
    // `import.meta.url` para ubicar el directorio de migraciones, que es lo que
    // Vitest provee y `__dirname` no.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts", "vitest.config.ts"]
}
