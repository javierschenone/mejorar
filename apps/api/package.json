{
  "name": "@mejorar/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de Mejorar. En esta etapa contiene únicamente el esquema de base de datos y sus migraciones (feature 004, tarea T-03). La aplicación NestJS la agrega dev-backend en la feature 007.",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "prisma:seed": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON prisma/seed.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.11.10",
    "pg": "8.13.1",
    "prisma": "6.19.3",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
